<!DOCTYPE html>
<html lang="fr" data-theme="bureau">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>LookuLooku</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚆</text></svg>">

  <%# Police principale. %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script>
    try {
      document.documentElement.setAttribute("data-theme", localStorage.getItem("theme") || "bureau");
    } catch (_) {}
  </script>
  <link rel="stylesheet" href="/styles/main.css">
</head>

<body>

  <header class="header">
    <a href="/" class="logo-link">
      looku<span>•</span>looku
    </a>
    <p class="header-date"><%= locals.dateAffichee %></p>
    <div class="header-actions">
      <% if (modeDemo) { %>
      <a class="badge-demo" href="/">Quitter la démo</a>
      <% } else if (demoDisponible) { %>
      <a class="badge-demo" href="/?demo=1">Démo</a>
      <% } %>
      <button class="theme-toggle" aria-label="Changer de thème" type="button"></button>
    </div>
  </header>

  <main id="dashboard-content" class="page">
  <% if (modeDemo) { %>
  <section class="barre-demo" aria-label="Démo : forcer un état à l’affichage">
    <p class="barre-demo-titre">Démo</p>
    <ul class="barre-demo-groupe">
      <% locals.boutonsMeteo.forEach(function (bouton) { %>
      <li>
        <a href="<%= bouton.href %>" class="barre-demo-bouton<%= bouton.actif ? ' actif' : '' %>">
          <%- icone(iconeMeteo(bouton.code, true), { taille: 15, temperature: bouton.temp }) %>
          <%= bouton.label %>
        </a>
      </li>
      <% }) %>
    </ul>
    <ul class="barre-demo-groupe">
      <% locals.boutonsTrafic.forEach(function (bouton) { %>
      <li>
        <a href="<%= bouton.href %>" class="barre-demo-bouton barre-demo-bouton-<%= bouton.cle %><%= bouton.actif ? ' actif' : '' %>">
          <span class="barre-demo-point"></span>
          <%= bouton.label %>
        </a>
      </li>
      <% }) %>
    </ul>
    <ul class="barre-demo-groupe">
      <% locals.boutonsService.forEach(function (bouton) { %>
      <li>
        <a href="<%= bouton.href %>" class="barre-demo-bouton<%= bouton.actif ? ' actif' : '' %>">
          <%= bouton.label %>
        </a>
      </li>
      <% }) %>
    </ul>
    <ul class="barre-demo-groupe">
      <% locals.boutonsRetard.forEach(function (bouton) { %>
      <li>
        <a href="<%= bouton.href %>" class="barre-demo-bouton<%= bouton.actif ? ' actif' : '' %>">
          <%= bouton.label %>
        </a>
      </li>
      <% }) %>
    </ul>
    <ul class="barre-demo-groupe">
      <% locals.boutonsPluie.forEach(function (bouton) { %>
      <li>
        <a href="<%= bouton.href %>" class="barre-demo-bouton<%= bouton.actif ? ' actif' : '' %>">
          <%- icone("goutte", { taille: 14 }) %>
          <%= bouton.label %>
        </a>
      </li>
      <% }) %>
    </ul>
    <ul class="barre-demo-groupe">
      <% locals.boutonsGym.forEach(function (bouton) { %>
      <li>
        <a href="<%= bouton.href %>" class="barre-demo-bouton<%= bouton.actif ? ' actif' : '' %>">
          <%- icone("haltere", { taille: 14 }) %>
          <%= bouton.label %>
        </a>
      </li>
      <% }) %>
    </ul>
    <ul class="barre-demo-groupe">
      <% locals.boutonsRetourMeaux.forEach(function (bouton) { %>
      <li>
        <a href="<%= bouton.href %>" class="barre-demo-bouton<%= bouton.actif ? ' actif' : '' %>">
          <%- icone("train", { taille: 14 }) %>
          <%= bouton.label %>
        </a>
      </li>
      <% }) %>
    </ul>
    <% if (meteoDemoActif || traficDemoActif || serviceDemoActif || retardDemoActif || pluieDemoActif || gymDemoActif || retourMeauxDemoActif) { %>
    <a href="/?demo=1" class="barre-demo-bouton barre-demo-reinit">Réinitialiser</a>
    <% } %>
  </section>
  <% } %>
  <% if (locals.erreur) { %>
  <p class="erreur">Oups : <%= erreur %></p>

  <% } else { %>

  <%# === Rangée principale : météo / prochain départ / prochaine arrivée === %>
  <% if (meteos && meteos.length === 2) { %>
  <section class="grille-principale">

    <%# --- Carte météo --- %>
    <% const sceneMeteoActuelle = sceneMeteo(meteos[0].current.weather_code, meteos[0].current.is_day === 1); %>
    <article class="carte carte-meteo" data-scene="<%= sceneMeteoActuelle %>" style="--couleur-icone-meteo: <%= couleurTemperature(meteos[0].current.temperature_2m) %>">
      <%- animationMeteoFond(sceneMeteoActuelle, meteos[0].current.temperature_2m) %>
      <div class="carte-meteo-haut">
        <div class="carte-meteo-icone" style="color: <%= couleurTemperature(meteos[0].current.temperature_2m) %>"><%- icone(iconeMeteo(meteos[0].current.weather_code, meteos[0].current.is_day === 1), { taille: 56, temperature: meteos[0].current.temperature_2m }) %></div>
        <div>
          <p class="temp"><%= Math.round(meteos[0].current.temperature_2m) %>°</p>
          <p class="condition"><%= traduireCodeMeteo(meteos[0].current.weather_code).replace(/^\S+\s*/u, "") %></p>
          <p class="ressenti">Ressenti <%= Math.round(meteos[0].current.apparent_temperature) %>°</p>
        </div>
      </div>

      <div class="carte-meteo-stats">
        <div class="stat">
          <span>Max</span>
          <strong><%= Math.round(meteos[0].daily.temperature_2m_max[0]) %>°</strong>
        </div>
        <div class="stat">
          <span>Min</span>
          <strong><%= Math.round(meteos[0].daily.temperature_2m_min[0]) %>°</strong>
        </div>
        <div class="stat">
          <span>Humidité</span>
          <strong><%= Math.round(meteos[0].current.relative_humidity_2m) %>%</strong>
        </div>
        <div class="stat">
          <span>Vent</span>
          <strong><%= Math.round(meteos[0].current.wind_speed_10m) %> km/h</strong>
        </div>
      </div>

      <% if (prochainePluieTrilport) { %>
      <% const pluieEnCours = prochainePluieTrilport.resume === "Pluie en cours"; %>
      <button class="pluie-toggle<%= pluieEnCours ? ' pluie-toggle-encours' : '' %>" type="button" aria-expanded="false" <%= (prochainePluieTrilport.dateExacte || pluieEnCours) ? '' : 'disabled' %>>
        <%- icone("goutte", { taille: 14 }) %>
        <span class="pluie-libelle">Pluie : <%= prochainePluieTrilport.resume.toLowerCase() %></span>
        <% if (prochainePluieTrilport.dateExacte) { %>
        <small><%= prochainePluieTrilport.dateExacte %></small>
        <% } %>
      </button>
      <% } %>
    </article>

    <%# --- Carte prochain départ --- %>
    <%# Lueur de carte selon le trafic ou le retard. %>
    <% const departGlow = niveauTrafic === "alerte" || (departsTrilportDepart[0] && departsTrilportDepart[0].retardNiveau === "fort") ? " carte-glow-alerte" : (departsTrilportDepart[0] && departsTrilportDepart[0].retardNiveau === "moyen") ? " carte-glow-chaude" : ""; %>
    <article class="carte carte-train carte-depart<%= departGlow %>">
      <div class="carte-train-entete">
        <span class="carte-train-entete-gauche">
          <span class="eyebrow">Départ</span>
          <% if (niveauTrafic === "alerte") { %>
          <span class="alerte-clignotante-conteneur">
            <span class="alerte-anneau"></span>
            <%- icone("alerte", { taille: 18, classe: "alerte-clignotante" }) %>
          </span>
          <% } %>
        </span>
        <% if (departsTrilportDepart[0]) { %><span class="countdown"><%= departsTrilportDepart[0].compteAReboursFormate %></span><% } %>
      </div>

      <% if (departsTrilportDepart.length > 0) { %>
      <p class="train-heure-principale succes"><%= departsTrilportDepart[0].heureFormatee %></p>
      <p class="train-destination">
        <%= departsTrilportDepart[0].destination %>
        <% if (departsTrilportDepart[0].ponctualiteLibelle) { %><span class="train-ponct-inline <%= departsTrilportDepart[0].ponctualiteClasse %>"><%= departsTrilportDepart[0].ponctualiteLibelle %></span><% } %>
      </p>
      <%# Espace réservé pour égaliser les deux cartes. %>
      <p class="train-puis" <% if (departsTrilportDepart.length <= 1) { %>style="visibility: hidden;"<% } %>>puis <%= departsTrilportDepart[1] ? departsTrilportDepart[1].heureFormatee : "—" %><% if (departsTrilportDepart[2]) { %> · <%= departsTrilportDepart[2].heureFormatee %><% } %></p>
      <% } else { %>
      <span class="statut-service <%= statutDeparts %>"><%= statutDeparts === "indisponible" ? "Indisponible" : statutDeparts === "attente" ? "En attente" : statutDeparts === "bientot" ? "Reprise bientôt" : "Fin de service" %></span>
      <% } %>

      <% if (departsTrilportDepart.length > 0) { %>
      <button class="carte-train-toggle" type="button" data-toggle-target="depart-details" aria-expanded="false">
        Voir départs <%- icone("chevron", { taille: 15, classe: "fleche-toggle" }) %>
      </button>
      <div class="disclosure carte-train-details" id="depart-details">
        <% departsTrilportDepart.forEach((train) => { %>
        <div class="train-detail-ligne">
          <span class="train-detail-heure <%= train.ponctualiteClasse %>"><%= train.heureFormatee %></span>
          <span class="train-detail-dest"><%= train.destination %></span>
          <% if (train.ecartMinutes) { %><span class="train-detail-ancienne"><%= train.heurePrevueFormatee %></span><% } %>
          <% if (train.ponctualiteLibelle) { %><span class="train-detail-ponct <%= train.ponctualiteClasse %>"><%= train.ponctualiteLibelle %></span><% } %>
        </div>
        <% }) %>
      </div>
      <% } %>
    </article>

    <%# --- Carte prochaine arrivée (iPad / écrans larges) --- %>
    <% const arriveeGlow = niveauTrafic === "alerte" || (arrivesTrilport[0] && arrivesTrilport[0].retardNiveau === "fort") ? " carte-glow-alerte" : (arrivesTrilport[0] && arrivesTrilport[0].retardNiveau === "moyen") ? " carte-glow-chaude" : ""; %>
    <article class="carte carte-train carte-arrivee carte-arrivee-classique<%= arriveeGlow %>">
      <div class="carte-train-entete">
        <span class="carte-train-entete-gauche">
          <span class="eyebrow">Arrivée</span>
          <% if (niveauTrafic === "alerte") { %>
          <span class="alerte-clignotante-conteneur">
            <span class="alerte-anneau"></span>
            <%- icone("alerte", { taille: 18, classe: "alerte-clignotante" }) %>
          </span>
          <% } %>
        </span>
        <% if (arrivesTrilport[0]) { %><span class="countdown"><%= arrivesTrilport[0].compteAReboursFormate %></span><% } %>
      </div>

      <% if (arrivesTrilport.length > 0) { %>
      <p class="train-heure-principale danger"><%= arrivesTrilport[0].heureFormatee %></p>
      <p class="train-destination">
        <%= arrivesTrilport[0].destination %>
        <% if (arrivesTrilport[0].ponctualiteLibelle) { %><span class="train-ponct-inline <%= arrivesTrilport[0].ponctualiteClasse %>"><%= arrivesTrilport[0].ponctualiteLibelle %></span><% } %>
      </p>
      <p class="train-puis" <% if (arrivesTrilport.length <= 1) { %>style="visibility: hidden;"<% } %>>puis <%= arrivesTrilport[1] ? arrivesTrilport[1].heureFormatee : "—" %><% if (arrivesTrilport[2]) { %> · <%= arrivesTrilport[2].heureFormatee %><% } %></p>
      <% } else { %>
      <span class="statut-service <%= statutArrivees %>"><%= statutArrivees === "indisponible" ? "Indisponible" : statutArrivees === "attente" ? "En attente" : statutArrivees === "bientot" ? "Reprise bientôt" : "Fin de service" %></span>
      <% } %>

      <% if (arrivesTrilport.length > 0) { %>
      <button class="carte-train-toggle" type="button" data-toggle-target="arrivee-details" aria-expanded="false">
        Voir arrivées <%- icone("chevron", { taille: 15, classe: "fleche-toggle" }) %>
      </button>
      <div class="disclosure carte-train-details" id="arrivee-details">
        <% arrivesTrilport.forEach((train) => { %>
        <div class="train-detail-ligne">
          <span class="train-detail-heure <%= train.ponctualiteClasse %>"><%= train.heureFormatee %></span>
          <span class="train-detail-dest"><%= train.destination %></span>
          <% if (train.ecartMinutes) { %><span class="train-detail-ancienne"><%= train.heurePrevueFormatee %></span><% } %>
          <% if (train.ponctualiteLibelle) { %><span class="train-detail-ponct <%= train.ponctualiteClasse %>"><%= train.ponctualiteLibelle %></span><% } %>
        </div>
        <% }) %>
      </div>
      <% } %>
    </article>

    <%# --- Carte retour Meaux vers Trilport, bus inclus (mobile uniquement) --- %>
    <% const retoursCarte = departsRetourEntete.slice(0, 3); %>
    <% const retourGlow = niveauTrafic === "alerte" || (retoursCarte[0] && retoursCarte[0].retardNiveau === "fort") ? " carte-glow-alerte" : (retoursCarte[0] && retoursCarte[0].retardNiveau === "moyen") ? " carte-glow-chaude" : ""; %>
    <article class="carte carte-train carte-arrivee carte-rentre-mobile<%= retourGlow %>">
      <div class="carte-train-entete">
        <span class="carte-train-entete-gauche">
          <span class="eyebrow">Rentre</span>
          <% if (niveauTrafic === "alerte") { %>
          <span class="alerte-clignotante-conteneur">
            <span class="alerte-anneau"></span>
            <%- icone("alerte", { taille: 18, classe: "alerte-clignotante" }) %>
          </span>
          <% } %>
        </span>
        <button class="rentre-bus-bouton" type="button" data-toggle-target="bus-retour-popup" aria-expanded="false" aria-label="Voir les bus vers la gare de Meaux">
          <%- icone("bus", { taille: 17 }) %>
        </button>
        <% if (retoursCarte[0]) { %><span class="countdown"><%= retoursCarte[0].compteAReboursFormate %></span><% } %>
      </div>

      <% if (retoursCarte.length > 0) { %>
      <p class="train-heure-principale danger"><%= retoursCarte[0].heureFormatee %></p>
      <p class="train-destination">
        Trilport
        <% if (retoursCarte[0].ponctualiteLibelle) { %><span class="train-ponct-inline <%= retoursCarte[0].ponctualiteClasse %>"><%= retoursCarte[0].ponctualiteLibelle %></span><% } %>
      </p>
      <p class="train-puis" <% if (retoursCarte.length <= 1) { %>style="visibility: hidden;"<% } %>>puis <%= retoursCarte[1] ? retoursCarte[1].heureFormatee : "—" %><% if (retoursCarte[2]) { %> · <%= retoursCarte[2].heureFormatee %><% } %></p>
      <% } else { %>
      <span class="statut-service <%= statutRetourMeaux %>"><%= statutRetourMeaux === "indisponible" ? "Indisponible" : statutRetourMeaux === "attente" ? "En attente" : statutRetourMeaux === "bientot" ? "Reprise bientôt" : "Fin de service" %></span>
      <% } %>

      <% if (retoursCarte.length > 0) { %>
      <button class="carte-train-toggle" type="button" data-toggle-target="rentre-details" aria-expanded="false">
        Voir retours <%- icone("chevron", { taille: 15, classe: "fleche-toggle" }) %>
      </button>
      <div class="disclosure carte-train-details" id="rentre-details">
        <% retoursCarte.forEach((train) => { %>
        <div class="train-detail-ligne">
          <span class="train-detail-heure <%= train.ponctualiteClasse %>"><%= train.heureFormatee %></span>
          <span class="train-detail-dest"><%= train.destination %></span>
          <% if (train.ecartMinutes) { %><span class="train-detail-ancienne"><%= train.heurePrevueFormatee %></span><% } %>
          <% if (train.ponctualiteLibelle) { %><span class="train-detail-ponct <%= train.ponctualiteClasse %>"><%= train.ponctualiteLibelle %></span><% } %>
        </div>
        <% }) %>
      </div>
      <% } %>
    </article>

  </section>

  <div class="disclosure popup-fond" id="bus-retour-popup" data-auto-close="false">
    <div class="popup-boite bus-retour-popup">
      <button class="popup-fermer" type="button" data-close-target="bus-retour-popup" aria-label="Fermer">
        <%- icone("fermer", { taille: 16 }) %>
      </button>
      <p class="popup-titre">On Air → Gare de Meaux</p>

      <div class="bus-principaux">
        <% busRetour.principaux.forEach((groupe) => { %>
        <article class="bus-trajet bus-groupe" data-ligne="<%= groupe.ligne %>">
          <div class="bus-trajet-entete">
            <strong class="bus-ligne" style="--ligne-fond:<%= groupe.couleur %>;--ligne-texte:<%= groupe.couleurTexte %>"><%= groupe.ligne %></strong>
            <span class="bus-identite"><span class="bus-verrou" aria-hidden="true"><%- icone("coche", { taille: 13 }) %></span><small class="bus-compte"><%= groupe.options && groupe.options[0] ? groupe.options[0].compteARebours : "—" %></small></span>
          </div>

          <% if (groupe.options.length > 0) { %>
          <div class="bus-choix bus-choix-<%= Math.min(groupe.options.length, 3) %>" aria-label="Choisir un passage <%= groupe.ligne %>">
            <% groupe.options.forEach((bus, index) => { %>
            <button type="button" data-bus-id="<%= bus.id %>" aria-pressed="false"><%= bus.departFormate %><% if (bus.retardHayette > 0) { %> <em>+<%= bus.retardHayette %></em><% } %></button>
            <% }) %>
          </div>

          <% groupe.options.forEach((bus, index) => { %>
          <div class="bus-detail-option<%= index === 0 ? " bus-detail-visible" : "" %>" data-bus-id="<%= bus.id %>" data-depart="<%= bus.depart %>" data-arrivee="<%= bus.arrivee %>" data-compte="<%= bus.compteARebours %>">
            <div class="bus-correspondance"><% if (bus.train) { %><%- icone("train", { taille: 13 }) %> <%= bus.train %><% if (bus.attenteTrain !== null) { %> · <%= bus.attenteTrain %> min<% } %><% } %></div>
            <p class="bus-depart-onair">Quitter On Air à <strong><%= bus.departOnAirFormate %></strong></p>
            <div class="bus-horaires">
              <div><span>La Hayette</span><strong><%= bus.departFormate %><% if (bus.retardHayette > 0) { %> <em class="bus-retard">+<%= bus.retardHayette %> min</em><% } %></strong></div>
              <div><span>Gare de Meaux</span><strong><%= bus.arriveeFormatee %><% if (bus.retardMeaux > 0) { %> <em class="bus-retard">+<%= bus.retardMeaux %> min</em><% } %></strong></div>
            </div>
            <div class="bus-parcours<%= bus.retardNiveau ? " bus-parcours-" + bus.retardNiveau : "" %>" data-depart="<%= bus.depart %>" data-arrivee="<%= bus.arrivee %>">
              <span class="bus-rail"></span><span class="bus-progression"></span>
              <span class="bus-arret bus-arret-hayette"></span><span class="bus-arret bus-arret-meaux"></span>
              <span class="bus-mobile"><%- illustrationBusCote() %></span>
            </div>
          </div>
          <% }) %>
          <% } else { %>
          <p class="bus-indisponible">Aucun passage disponible.</p>
          <% } %>
        </article>
        <% }) %>
      </div>

      <div class="bus-autres">
        <p class="bus-autres-titre">Autres lignes</p>
        <% if (busRetour.autres.length > 0) { %>
        <ul>
          <% busRetour.autres.forEach((bus) => { %>
          <li>
            <div class="bus-option-horaires">
              <strong class="bus-ligne bus-ligne-petite" style="--ligne-fond:<%= bus.couleur %>;--ligne-texte:<%= bus.couleurTexte %>"><%= bus.ligne %></strong>
              <span class="bus-option-arret"><%= bus.arret || "Départ" %></span>
              <span class="bus-option-meaux">Meaux</span>
              <strong class="bus-option-heure"><%= bus.departFormate %><% if (bus.retardHayette > 0) { %> <em class="bus-retard">+<%= bus.retardHayette %></em><% } %></strong>
              <strong class="bus-option-arrivee"><%= bus.arriveeFormatee %><% if (bus.retardMeaux > 0) { %> <em class="bus-retard">+<%= bus.retardMeaux %></em><% } %></strong>
            </div>
          </li>
          <% }) %>
        </ul>
        <% } else { %>
        <p class="bus-indisponible">Aucune autre correspondance utile actuellement.</p>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <%# === Carte gym === %>
  <section class="carte carte-gym<%= gymCacheAujourdhui ? " gym-termine" : "" %>">
    <div class="carte-gym-entete">
      <button class="gym-bouton-termine" type="button" id="gym-bouton-termine" aria-pressed="<%= gymCacheAujourdhui ? "true" : "false" %>" data-est-dimanche="<%= estDimancheAujourdhui ? "true" : "false" %>" aria-label="<%= estDimancheAujourdhui ? "Voir les trajets malgré le jour de repos" : "Marquer la séance comme terminée" %>">
        <span class="eyebrow"><%- icone("haltere", { taille: 15 }) %> Gym</span>
      </button>
      <div class="gym-entete-droite">
        <% if (meteos[1]) { %>
        <span class="meaux-meteo">
          <%- icone(iconeMeteo(meteos[1].current.weather_code, meteos[1].current.is_day === 1), { taille: 15, temperature: meteos[1].current.temperature_2m }) %>
          Meaux <%= Math.round(meteos[1].current.temperature_2m) %>°
        </span>
        <% } %>
        <%# Prochain retour Meaux → Trilport, toujours affiché (LOOK-43). %>
        <% if (departsRetourEntete && departsRetourEntete.length > 0) { %>
        <span class="meaux-retour<%= departsRetourEntete[0].retardNiveau ? " meaux-retour-" + departsRetourEntete[0].retardNiveau : "" %>">
          <%- icone("train", { taille: 13 }) %>
          <%= departsRetourEntete[0].heureFormatee %>
          <% if (departsRetourEntete[0].ponctualiteLibelle) { %><span class="meaux-retour-ponct"><%= departsRetourEntete[0].ponctualiteLibelle %></span><% } %>
        </span>
        <% } else { %>
        <span class="meaux-retour meaux-retour-<%= statutRetourMeaux %>">
          <%- icone("train", { taille: 13 }) %>
          <%= statutRetourMeaux === "indisponible" ? "Indisponible" : statutRetourMeaux === "attente" ? "En attente" : statutRetourMeaux === "bientot" ? "Reprise bientôt" : "Fin de service" %>
        </span>
        <% } %>
        <% if (trajetsGymTous && trajetsGymTous.length > 0) { %>
        <button class="gym-bouton-popup" type="button" data-toggle-target="gym-popup" aria-expanded="false" aria-label="Voir tous les trajets">
          <%- icone("liste", { taille: 14 }) %>
        </button>
        <% } %>
      </div>
    </div>

    <% if (estDimancheAujourdhui) { %>
    <p class="gym-termine-message gym-repos-message">
      <span class="gym-repos-texte">Jour de repos.</span>
      <span class="gym-zzz" aria-hidden="true"><span>Z</span><span>Z</span><span>Z</span></span>
    </p>
    <% } else { %>
    <p class="gym-termine-message">Séance faite pour aujourd'hui.</p>
    <% } %>

    <div class="gym-corps">
      <% if (!trajetsGym || trajetsGym.length === 0) { %>
      <p class="gym-indisponible">Aucun trajet disponible.</p>
      <% } else { %>
      <div class="gym-fenetres">
        <% trajetsGym.forEach((t, i) => { %>
        <div class="gym-fenetre<%= i === 0 ? " gym-fenetre-active" : "" %>" data-expire="<%= t.expirationHeure %>">
          <div class="gym-colonnes">
            <div class="gym-col">
              <div class="gym-sous-stack" data-champ="depart">
                <% t.sousCreneaux.forEach((s, j) => { %>
                <div class="gym-sous<%= j === 0 ? " gym-sous-active" : "" %>">
                  <span>Départ</span>
                  <strong><%= s.depart.heureFormatee %></strong><% if (s.depart.estime) { %><small class="gym-estime gym-estime-ligne">estimé</small><% } %>
                  <small class="gym-col-train">
                    <%= s.aller.heureFormatee %><% if (s.aller.ecartMinutes >= 3) { %> <span class="gym-retard">+<%= s.aller.ecartMinutes %>min</span><% } %><%- icone("train", { taille: 13 }) %>
                  </small>
                </div>
                <% }) %>
              </div>
            </div>
            <div class="gym-col">
              <span>Météo</span>
              <strong class="gym-col-verdict"><%- icone(iconeVerdict(t.meteo.verdicts), { taille: 17 }) %> <%= t.meteo.resume.replace(/^\S+\s*/u, "") %></strong>
              <div class="gym-sous-stack" data-champ="duree">
                <% t.sousCreneaux.forEach((s, j) => { %>
                <small class="gym-sous<%= j === 0 ? " gym-sous-active" : "" %> gym-col-duree"><%= s.dureeFormatee %> à la salle</small>
                <% }) %>
              </div>
            </div>
            <div class="gym-col">
              <div class="gym-sous-stack" data-champ="retour">
                <% t.sousCreneaux.forEach((s, j) => { %>
                <div class="gym-sous<%= j === 0 ? " gym-sous-active" : "" %>">
                  <span><%= s.procheDuMax ? "Partir avant" : "Retour" %></span>
                  <strong><%= s.departSalleFormatee %></strong><% if (s.retour.estime) { %><small class="gym-estime gym-estime-ligne">estimé</small><% } %>
                  <small class="gym-col-train">
                    <%- icone("train", { taille: 13 }) %><%= s.retour.heureFormatee %><% if (s.retour.ecartMinutes >= 3) { %> <span class="gym-retard">+<%= s.retour.ecartMinutes %>min</span><% } %>
                  </small>
                </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <% if (trajetsGym.length > 1) { %>
      <ul class="gym-alternatives gym-alternatives-<%= Math.min(trajetsGym.length - 1, 2) %>">
        <% trajetsGym.forEach((t, i) => { %>
        <li class="gym-alternative<%= i === 0 ? " gym-alternative-cachee" : "" %>" data-index="<%= i %>">
          <%- icone(iconeVerdict(t.meteo.verdicts), { taille: 12 }) %>
          <span class="gym-alternative-meteo"><%= t.meteo.resume.replace(/^\S+\s*/u, "") %></span>
          <span class="gym-alternative-heures"><%= t.depart.heureFormatee %> → <%= t.departSalleFormatee %></span>
          <span class="gym-alternative-duree"><%= t.dureeFormatee %></span>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <% } %>
    </div>
  </section>

  <% if (trajetsGymTous && trajetsGymTous.length > 0) { %>
  <div class="disclosure popup-fond" id="gym-popup"<% if (gymVerrouilleActif) { %> data-verrouille-aller="<%= gymVerrouilleActif.allerHeure %>" data-verrouille-retour="<%= gymVerrouilleActif.retourHeure %>"<% } %>>
    <div class="popup-boite">
      <button class="popup-fermer" type="button" data-close-target="gym-popup" aria-label="Fermer">
        <%- icone("fermer", { taille: 16 }) %>
      </button>
      <p class="popup-titre">Tous les trajets possibles</p>
      <ul class="gym-alternatives gym-popup-liste">
        <% trajetsGymTous.forEach((groupe) => { groupe.sousCreneaux.forEach((t) => { %>
        <%# Sélectionnable : verrouille ce trajet précis en vitrine jusqu'à
            son heure de départ salle (data-expire), voir gym.js. %>
        <li class="gym-alternative" data-expire="<%= t.departSalleHeure %>" data-aller="<%= t.aller.heure %>" data-retour="<%= t.retour.heure %>"<% if (!gymCacheAujourdhui) { %> role="button" tabindex="0"<% } %>>
          <%- icone(iconeVerdict(t.meteo.verdicts), { taille: 12 }) %>
          <span class="gym-alternative-meteo"><%= t.meteo.resume.replace(/^\S+\s*/u, "") %></span>
          <span class="gym-alternative-heures"><%= t.depart.heureFormatee %> → <%= t.departSalleFormatee %></span>
          <span class="gym-alternative-duree"><%= t.dureeFormatee %></span>
          <template>
            <div class="gym-colonnes">
              <div class="gym-col">
                <div class="gym-sous-stack" data-champ="depart">
                  <div class="gym-sous gym-sous-active">
                    <span>Départ</span>
                    <strong><%= t.depart.heureFormatee %></strong><% if (t.depart.estime) { %><small class="gym-estime gym-estime-ligne">estimé</small><% } %>
                    <small class="gym-col-train">
                      <%= t.aller.heureFormatee %><% if (t.aller.ecartMinutes >= 3) { %> <span class="gym-retard">+<%= t.aller.ecartMinutes %>min</span><% } %><%- icone("train", { taille: 13 }) %>
                    </small>
                  </div>
                </div>
              </div>
              <div class="gym-col">
                <span>Météo</span>
                <strong class="gym-col-verdict"><%- icone(iconeVerdict(t.meteo.verdicts), { taille: 17 }) %> <%= t.meteo.resume.replace(/^\S+\s*/u, "") %></strong>
                <div class="gym-sous-stack" data-champ="duree">
                  <small class="gym-sous gym-sous-active gym-col-duree"><%= t.dureeFormatee %> à la salle</small>
                </div>
              </div>
              <div class="gym-col">
                <div class="gym-sous-stack" data-champ="retour">
                  <div class="gym-sous gym-sous-active">
                    <span><%= t.procheDuMax ? "Partir avant" : "Retour" %></span>
                    <strong><%= t.departSalleFormatee %></strong><% if (t.retour.estime) { %><small class="gym-estime gym-estime-ligne">estimé</small><% } %>
                    <small class="gym-col-train">
                      <%- icone("train", { taille: 13 }) %><%= t.retour.heureFormatee %><% if (t.retour.ecartMinutes >= 3) { %> <span class="gym-retard">+<%= t.retour.ecartMinutes %>min</span><% } %>
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </template>
        </li>
        <% }) }) %>
      </ul>
    </div>
  </div>
  <% } %>

  <% } %>

  <%# === Carte trafic (toujours affichée, même en cas d'erreur ailleurs) === %>
  <section class="carte carte-trafic carte-trafic-<%= niveauTrafic %>">
    <% if (locals.prochaineTravaux) { %>
    <button class="carte-trafic-icone-bouton carte-trafic-travaux-bouton" type="button" data-toggle-target="travaux-details" aria-expanded="false" aria-label="Travaux Ligne P">
      <%- icone("travaux", { taille: 16 }) %>
    </button>
    <% } %>

    <button class="carte-trafic-corps" type="button"<% if (detailAlerte) { %> data-toggle-target="trafic-details" aria-expanded="false" aria-label="Afficher les détails du trafic"<% } else { %> disabled<% } %>>
      <span class="statut-dot"></span>
      <div class="carte-trafic-texte">
        <% if (niveauTrafic === "fluide") { %>
        <p class="carte-trafic-titre">Trafic fluide</p>
        <% } else if (niveauTrafic === "info") { %>
        <p class="carte-trafic-titre">Perturbation sur la ligne P</p>
        <% } else if (niveauTrafic === "ailleurs" || niveauTrafic === "alerte") { %>
        <p class="carte-trafic-titre"><%= texteAlerte %></p>
        <% } else { %>
        <p class="carte-trafic-titre">Infos trafic temporairement indisponibles</p>
        <% } %>
      </div>
    </button>

    <%- illustrationTrain(niveauTrafic, locals.phaseServiceActuelle) %>
  </section>

  <% if (detailAlerte) { %>
  <div class="disclosure popup-fond" id="trafic-details">
    <div class="popup-boite">
      <button class="popup-fermer" type="button" data-close-target="trafic-details" aria-label="Fermer">
        <%- icone("fermer", { taille: 16 }) %>
      </button>
      <p class="popup-titre"><%= texteAlerte %></p>
      <p><%= detailAlerte.details %></p>
      <% if (detailAlerte.trajet) { %>
      <p class="panneau-meta">Trajet : <%= detailAlerte.trajet %></p>
      <% } %>
      <% if (detailAlerte.debut) { %>
      <p class="panneau-meta">Du <%= formaterDatePerturbation(detailAlerte.debut) %> au <%= formaterDatePerturbation(detailAlerte.fin) %></p>
      <% } %>
    </div>
  </div>
  <% } %>

  <% if (locals.prochaineTravaux) { %>
  <div class="disclosure popup-fond" id="travaux-details">
    <div class="popup-boite">
      <button class="popup-fermer" type="button" data-close-target="travaux-details" aria-label="Fermer">
        <%- icone("fermer", { taille: 16 }) %>
      </button>
      <p class="popup-titre">Travaux Ligne P</p>
      <% travauxFuturs.forEach((travaux) => { %>
      <p class="panneau-travaux-item">
        <%= travaux.dateDebut %> → <%= travaux.dateFin %>
        <% if (travaux.trajet) { %> • <%= travaux.trajet %><% } %>
      </p>
      <% }) %>
    </div>
  </div>
  <% } %>

  </main>

  <script type="module" src="/scripts/theme.js"></script>
  <script type="module" src="/scripts/refresh.js"></script>
  <script type="module" src="/scripts/disclosure.js"></script>
  <script type="module" src="/scripts/weather-details.js"></script>
  <script type="module" src="/scripts/gym.js"></script>
  <script type="module" src="/scripts/bus-return.js"></script>
</body>

</html>
